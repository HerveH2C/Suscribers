# --- Supabase ---------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé service_role (JAMAIS la clé anon) — bypass RLS, à garder strictement
# côté serveur (jamais dans le plugin WordPress ni dans un front-end).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Sécurité de l'API elle-même --------------------------------------
# Clé utilisée par WordPress pour l'endpoint public de vérification d'accès
# (POST /api/access/check). Portée volontairement limitée : lecture seule.
ACCESS_API_KEY=change-moi-une-longue-cle-aleatoire

# Clé utilisée par le plugin WordPress d'administration pour les routes
# /api/admin/* (CRUD complet). À générer avec ex. `openssl rand -hex 32`.
ADMIN_API_KEY=change-moi-une-autre-longue-cle-aleatoire

# --- Serveur ------------------------------------------------------------
PORT=3000
# Domaine(s) autorisé(s) à appeler l'API en cross-origin (séparés par des
# virgules). Laisser vide si tous les appels viennent du serveur WordPress
# (PHP côté serveur, donc pas de CORS nécessaire).
ALLOWED_ORIGINS=
